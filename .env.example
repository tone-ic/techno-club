# ─── FRONTEND (apps/web) ───────────────────────────────────────────────────────
# Эти переменные публичны — попадают в браузер. Начинаются с VITE_

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

VITE_COLYSEUS_URL=ws://localhost:2567
# Продакшен: wss://doorclub-gameserver.fly.dev

VITE_LIVEKIT_URL=ws://localhost:7880
# Cloud: wss://doorclub.livekit.cloud
# Self-hosted: wss://doorclub-livekit.fly.dev

VITE_API_URL=http://localhost:3001
# Продакшен: https://doorclub-api.fly.dev
VITE_HF_TRELLIS_SPACE_ID=trellis-community/TRELLIS
VITE_HF_PIXAL3D_INSTANCE_URLS=
VITE_PIXAL3D_GENERATE_TIMEOUT_MS=300000
VITE_TRELLIS_TEXTURE_SIZE=2048
VITE_TRELLIS_MESH_SIMPLIFY=0.9

# ─── BACKEND — ТОЛЬКО НА СЕРВЕРЕ, НИКОГДА В БРАУЗЕР ──────────────────────────

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=
SUPABASE_JWKS=
# ⚠️  service_role имеет полный доступ к БД, минуя RLS!

LIVEKIT_API_KEY=APIxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_URL=ws://localhost:7880

# ─── GAME SERVER ──────────────────────────────────────────────────────────────
GAME_SERVER_PORT=2567

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001

# Local dev: leave TRELLIS_WORKER_URL empty to use the public Hugging Face TRELLIS Space.
# Set TRELLIS_WORKER_PROVIDER=disabled to skip GLB generation and keep the procedural fallback.
# Production: private GPU worker URL. Never expose these as VITE_* values.
TRELLIS_WORKER_PROVIDER=
TRELLIS_WORKER_URL=
TRELLIS_WORKER_TOKEN=
HF_TRELLIS_SPACE_ID=trellis-community/TRELLIS
HF_PIXAL3D_INSTANCE_URLS=
HF_TOKEN=
TRELLIS_TEXTURE_SIZE=2048
TRELLIS_MESH_SIMPLIFY=0.9
MAX_AVATAR_MODEL_UPLOAD_BYTES=45000000
SUPABASE_AVATAR_MODELS_BUCKET=avatar-models

# Server-side KIE GPT Image 2 I2I preprocessing. Comma/newline separated keys are
# rotated per request; exhausted/invalid keys are skipped for the next configured key.
KIE_API_KEYS=your_kie_api_key
KIE_API_KEYS_FILE=
KIE_API_BASE_URL=https://api.kie.ai
KIE_FILE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
KIE_CREATE_TIMEOUT_MS=45000
KIE_POLL_TIMEOUT_MS=900000
KIE_DOWNLOAD_TIMEOUT_MS=90000

# Optional free local autorig pass for generated GLBs.
# Requires Blender installed on the API host. Leave disabled until `blender --version` works
# or set BLENDER_PATH to the full executable path.
BLENDER_AUTORIG_ENABLED=1
BLENDER_PATH=blender
BLENDER_AUTORIG_TIMEOUT_MS=180000
# Keep raw generated GLB in rooms for maximum visual fidelity. Runtime avatar rig handles motion.
BLENDER_AUTORIG_REPLACE_MODEL_URL=1

# Optional: enables game-server BPM analysis from audio files.
# Set to a full executable path when ffmpeg is not available in PATH.
FFMPEG_PATH=ffmpeg
