{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true
  },
  "include": ["src/index.ts", "src/env.ts", "src/persistence.ts"],
  "exclude": ["node_modules", "src/rooms/**/*", "src/schemas/**/*"]
}
